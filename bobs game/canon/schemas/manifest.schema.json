{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapkitty.example/canon/schemas/manifest.schema.json",
  "title": "SnapKitty Canon Manifest",
  "type": "object",
  "required": ["canonId", "version", "releasedAt", "compatibility", "collections", "characterBreakdown"],
  "properties": {
    "$schema": { "type": "string" },
    "canonId": { "const": "snapkitty-universe" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "releasedAt": { "type": "string", "format": "date" },
    "compatibility": {
      "type": "object",
      "required": ["minimumReaderVersion", "persistenceNamespace"],
      "properties": {
        "minimumReaderVersion": { "type": "string" },
        "persistenceNamespace": { "type": "string" }
      },
      "additionalProperties": false
    },
    "collections": {
      "type": "object",
      "required": ["species", "locations", "experiences", "equipment", "quests", "characters", "bindings", "economy"],
      "additionalProperties": { "$ref": "#/$defs/collection" }
    },
    "characterBreakdown": {
      "type": "object",
      "required": ["council", "agent", "civilian"],
      "properties": {
        "council": { "const": 12 },
        "agent": { "const": 8 },
        "civilian": { "const": 30 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "required": ["path", "schema", "count"],
      "properties": {
        "path": { "type": "string" },
        "schema": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
