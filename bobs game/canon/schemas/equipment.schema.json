{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapkitty.example/canon/schemas/equipment.schema.json",
  "title": "SnapKitty Equipment Collection",
  "type": "object",
  "required": ["version", "equipment"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "description", "capabilities", "manufacturer", "rarity", "tradable"],
        "properties": {
          "id": { "type": "string", "pattern": "^eq-[a-z0-9-]+$" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string", "minLength": 12 },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "manufacturer": { "type": "string" },
          "rarity": { "enum": ["common", "specialist", "rare", "unique"] },
          "tradable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
