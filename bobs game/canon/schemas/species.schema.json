{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapkitty.example/canon/schemas/species.schema.json",
  "title": "SnapKitty Species Collection",
  "type": "object",
  "required": ["version", "species"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "species": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "origins", "traits", "lifespan", "communication"],
        "properties": {
          "id": { "type": "string", "pattern": "^species-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 20 },
          "origins": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "traits": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "lifespan": { "type": "string" },
          "communication": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
