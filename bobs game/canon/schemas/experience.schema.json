{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapkitty.example/canon/schemas/experience.schema.json",
  "title": "SnapKitty Experience Collection",
  "type": "object",
  "required": ["version", "experiences"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "projectId", "locationId", "summary", "entryAction", "completionEvents", "canonRewards", "repeatable"],
        "properties": {
          "id": { "type": "string", "pattern": "^exp-[a-z0-9-]+$" },
          "name": { "type": "string" },
          "projectId": { "type": "string" },
          "locationId": { "type": "string" },
          "summary": { "type": "string", "minLength": 20 },
          "entryAction": { "type": "string" },
          "completionEvents": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "canonRewards": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "repeatable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
